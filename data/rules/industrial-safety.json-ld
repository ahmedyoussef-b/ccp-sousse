{
  "@context": "https://schema.org/",
  "@type": "IndustrialSafetyDomain",
  "name": "Industrial Standard Safety Rules",
  "rules": [
    {
      "id": "RULE_VALVE_PRESSURE",
      "description": "Sécurité vanne/pression",
      "type": "vanne",
      "ifActionMatches": ["ouvrir", "vanne", "ouverture"],
      "preConditions": ["pression_basse_verifiee", "consignation_active"],
      "postConditions": ["vanne_ouverte"],
      "safetyMessage": "ALERTE : Tentative d'ouverture de vanne sans vérification de la pression ou consignation préalable.",
      "severity": "critical"
    },
    {
      "id": "RULE_API670_STARTUP",
      "description": "Vibrations API 670",
      "type": "vibration",
      "ifActionMatches": ["demarrer", "lancement", "startup", "turbine"],
      "preConditions": ["capteurs_actifs", "monitoring_vibration_ok"],
      "postConditions": ["rotation_active"],
      "safetyMessage": "ALERTE : Conformité API 670 - Le démarrage de la machine nécessite l'activation préalable du monitoring de vibration.",
      "severity": "critical"
    },
    {
      "id": "RULE_ELECTRICAL_LOCKOUT",
      "description": "Consignation électrique",
      "type": "electricite",
      "ifActionMatches": ["intervenir", "reparation", "maintenance", "moteur"],
      "preConditions": ["consignation_electrique_active"],
      "postConditions": ["zone_securisee"],
      "safetyMessage": "DANGER : Toute intervention de maintenance moteur nécessite une consignation électrique LOTO (Lockout/Tagout).",
      "severity": "critical"
    },
    {
      "id": "RULE_INITIAL_WATER_LEVEL",
      "description": "Niveau d'eau chaudière",
      "type": "temperature",
      "ifActionMatches": ["chauffage", "allumage", "brûleur"],
      "preConditions": ["niveau_eau_ok"],
      "postConditions": ["cycle_chauffe_actif"],
      "safetyMessage": "ALERTE : L'allumage du brûleur nécessite un niveau d'eau suffisant pour éviter une surchauffe à sec.",
      "severity": "critical"
    }
  ]
}
